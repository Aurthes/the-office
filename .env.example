# Browser/client gateway URL (build-time — requires `npm run build` after changes)
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:18789

# Optional: dashboard opened by the spaceship monitor room (build-time).
# NEXT_PUBLIC_CLAW3D_GRAFANA_URL=https://grafana.example.com/d/dashboard-id/dashboard
# Optional runtime default for the configurable monitoring console.
# CLAW3D_GRAFANA_URL=https://grafana.example.com/d/dashboard-id/dashboard
# Opt in to read-only SSH host metrics from a local server-pool registry.
# CLAW3D_SERVER_POOL_FILE=/path/to/server_pool.conf

# Runtime gateway URL — takes effect on restart without a rebuild.
# Use this instead of NEXT_PUBLIC_GATEWAY_URL when you want to change the
# gateway endpoint without re-running `npm run build`.
# CLAW3D_GATEWAY_URL=ws://localhost:18789
# CLAW3D_GATEWAY_TOKEN=
# Optional: tell Studio which backend that runtime gateway URL represents.
# Valid values: openclaw, demo
# CLAW3D_GATEWAY_ADAPTER_TYPE=openclaw

# Debug UI
DEBUG=true

# App server
# PORT=3000
# HOST=127.0.0.1

# Optional: required only for public/remote deployments
# STUDIO_ACCESS_TOKEN=

# Demo gateway (no OpenClaw required)
# Run `npm run demo-gateway` and connect Claw3D to ws://localhost:18789
# DEMO_ADAPTER_PORT=18789
# If CLAW3D_GATEWAY_URL is unset, Studio can still detect this local adapter port.

# Independent Office Codex runtime (npm run codex-gateway)
# Use an independently installed, pinned Codex CLI; do not point at the native App.
# CLAW3D_CODEX_BIN=/absolute/path/to/codex
# CODEX_ADAPTER_PORT=18790
# CLAW3D_OFFICE_DATA_DIR=/absolute/path/to/office-runtime
# CLAW3D_OFFICE_CODEX_HOME=/absolute/path/to/office-runtime/codex
# Studio: CLAW3D_GATEWAY_URL=ws://127.0.0.1:18790 and CLAW3D_CODEX_GATEWAY=1
# Studio build: NEXT_PUBLIC_CLAW3D_SESSION_VIEW=1
# Set the same private CLAW3D_GATEWAY_TOKEN for both services.
# Optional public speech/suggestion APIs, configured on the gateway only:
# OPENAI_API_KEY=
# AI Center: optional read-only project rate-limit display (gateway only).
# Requires an OpenAI organization admin key; a normal API key cannot read these limits.
# OPENAI_ADMIN_KEY=
# OPENAI_PROJECT_ID=
# CLAW3D_TRANSCRIPTION_MODEL=gpt-transcribe
# CLAW3D_SUGGESTION_MODEL=gpt-6.1-sol
# Live voice is not connected to this runtime.
